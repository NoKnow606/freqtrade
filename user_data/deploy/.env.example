# Copy to .env next to docker-compose.yml. Never commit .env.
# freqtrade reads FREQTRADE__<SECTION>__<KEY> and overrides config_regime.json,
# so secrets never have to live in the json file.

# --- exchange keys (OKX "trade" permission only, IP-whitelisted, no withdraw) ---
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__EXCHANGE__PASSWORD=

# --- API server (FreqUI + REST control) ---
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=change-me-now
FREQTRADE__API_SERVER__JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
FREQTRADE__API_SERVER__WS_TOKEN=replace-with-openssl-rand-hex-32

# --- telegram (optional) ---
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- signal producer ---
REGIME_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
REGIME_EXCHANGE=okx
REGIME_TIMEFRAME=4h
REGIME_INTERVAL=900
